@{
    ViewData["Title"] = "Forgot password";
    Layout = "_AuthLayout";
}

<h1 style="font-size:22px;margin-bottom:4px;">Forgot password</h1>
<p style="color:var(--muted);margin-bottom:24px;">Enter your email or username and we'll email you a verification code right away.</p>

<form asp-action="ForgotPassword" method="post">
    @Html.AntiForgeryToken()
    <div class="field">
        <label>Email or username</label>
        <input class="input" type="text" name="email" required autofocus />
    </div>

    <div asp-validation-summary="All" class="text-danger" style="margin-bottom:12px;"></div>

    <button type="submit" class="btn btn-primary btn-block" style="width:100%;margin-top:8px;">Send code</button>
</form>

<p style="margin-top:20px;text-align:center;font-size:13px;"><a asp-action="Login">Back to sign in</a></p>
