@model Appointment
@{
    ViewData["Title"] = "Edit appointment";
}
<div class="page-header">
    <div>
        <h1>Edit appointment</h1>
        <p>@Model.Id</p>
    </div>
    <a class="btn btn-ghost" asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
</div>

<div class="card" style="max-width:560px;">
    <div class="card-body" style="padding:24px;">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="All" class="text-danger" style="margin-bottom:12px;"></div>

            <div class="field">
                <label asp-for="CustomerId">Customer ID</label>
                <input class="input" asp-for="CustomerId" required />
            </div>
            <div class="field">
                <label asp-for="VehicleId">Vehicle ID</label>
                <input class="input" asp-for="VehicleId" required />
            </div>
            <div class="field">
                <label asp-for="CreatedById">Created by</label>
                <input class="input" asp-for="CreatedById" />
            </div>
            <div class="field">
                <label asp-for="ScheduledAt">Scheduled date &amp; time</label>
                <input class="input" name="ScheduledAt" type="datetime-local"
                       value="@Model.ScheduledAt.ToString("yyyy-MM-ddTHH:mm")" />
            </div>
            <div class="field">
                <label asp-for="Status">Status</label>
                <select class="input" asp-for="Status">
                    <option value="Scheduled">Scheduled</option>
                    <option value="Arrived">Arrived</option>
                    <option value="Cancelled">Cancelled</option>
                    <option value="Completed">Completed</option>
                </select>
            </div>

            <button type="submit" class="btn btn-primary" style="margin-top:12px;">Save changes</button>
        </form>
    </div>
</div>
