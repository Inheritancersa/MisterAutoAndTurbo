@model Complaint
@{
    ViewData["Title"] = "Record complaint";
}
<div class="page-header">
    <div>
        <h1>Record customer complaint</h1>
    </div>
    <a class="btn btn-ghost" asp-action="Index">Back</a>
</div>
<div class="card" style="max-width:560px;">
    <div class="card-body" style="padding:24px;">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="field">
                <label asp-for="CustomerId">Customer ID</label>
                <input class="input" asp-for="CustomerId" required />
            </div>
            <div class="field">
                <label asp-for="JobCardId">Job card ID (optional)</label>
                <input class="input" asp-for="JobCardId" />
            </div>
            <div class="field">
                <label asp-for="Description">Description</label>
                <textarea class="input" asp-for="Description" rows="4" required></textarea>
            </div>
            <button type="submit" class="btn btn-primary" style="margin-top:12px;">Save complaint</button>
        </form>
    </div>
</div>
