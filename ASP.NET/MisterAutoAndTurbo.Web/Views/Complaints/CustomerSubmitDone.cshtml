@model Complaint
@{
    Layout = null;
    var name = ViewBag.CustomerName as string ?? "Customer";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Complaint sent</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet" />
    <style>
        body { margin: 0; font-family: Inter, system-ui, sans-serif; background: #0D1A2E; min-height: 100vh; }
        .shell { max-width: 420px; margin: 0 auto; min-height: 100vh; background: #F3F5F9; padding: 40px 20px; text-align: center; }
        h1 { font-size: 20px; color: #151B2E; }
        p { color: #6B7387; font-size: 14px; line-height: 1.5; }
        .ok { width: 56px; height: 56px; border-radius: 50%; background: #E1F4E9; color: #2E9E5B;
              display: flex; align-items: center; justify-content: center; margin: 0 auto 16px; font-size: 28px; }
        a { color: #2B6CB0; }
    </style>
</head>
<body>
<div class="shell">
    <div class="ok">✓</div>
    <h1>Complaint submitted</h1>
    <p>Thanks, @name. Reference <strong>@Model.Id</strong>. The workshop team has been notified and will get back to you.</p>
    <p><a asp-action="CustomerSubmit">Submit another</a></p>
</div>
</body>
</html>
