@model IEnumerable<Complaint>
@{
    var q = ViewBag.Query as string;
    ViewData["Title"] = "Complaints";
    var names = ViewBag.CustomerNames as Dictionary<string, string> ?? new Dictionary<string, string>();
    var openCount = ViewBag.OpenCount as int? ?? 0;
    var statusFilter = ViewBag.StatusFilter as string;
}
<div class="page-header">
    <div>
        <h1>Customer complaints</h1>
        <p>From the mobile app and staff records
            @if (openCount > 0)
            {
                <span class="pill pill-amber" style="margin-left:8px;">@openCount open</span>
            }
        </p>
    </div>
    <div style="display:flex;gap:8px;flex-wrap:wrap;">
        
        <a class="btn btn-primary" asp-action="Create">+ Record complaint</a>
    </div>
</div>

<div class="card" style="margin-bottom:16px;">
    <div class="card-body" style="padding:16px;">
        <form method="get" asp-action="Index" style="display:flex;flex-wrap:wrap;gap:12px;align-items:end;">
            <div class="field" style="margin:0;min-width:160px;">
                <label>Status</label>
                <select class="input" name="status">
                    <option value="">— All —</option>
                    <option value="Open" selected="@(statusFilter == "Open")">Open</option>
                    <option value="In Progress" selected="@(statusFilter == "In Progress")">In Progress</option>
                    <option value="Resolved" selected="@(statusFilter == "Resolved")">Resolved</option>
                    <option value="Closed" selected="@(statusFilter == "Closed")">Closed</option>
                </select>
            </div>
            <div class="field" style="margin:0;min-width:200px;">
                <label>Customer</label>
                <select class="input" name="customerId" asp-items="ViewBag.Customers">
                    <option value="">— All customers —</option>
                </select>
            </div>
            <div class="field" style="margin:0;flex:1;min-width:200px;">
                <label>Search</label>
                <input class="input" type="search" name="q" value="@q" placeholder="Subject, customer, description, job…" />
            </div>
            <button type="submit" class="btn btn-ghost">Filter</button>
            <a class="btn btn-ghost" asp-action="Index">Clear</a>
        </form>
    </div>
</div>

<div class="card">
    <table class="table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Customer</th>
                <th>Subject</th>
                <th>Source</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var c in Model)
            {
                var pill = c.Status switch
                {
                    "Open" => "pill pill-amber",
                    "In Progress" => "pill pill-blue",
                    "Resolved" => "pill pill-green",
                    "Closed" => "pill",
                    _ => "pill"
                };
                var name = names.ContainsKey(c.CustomerId) ? names[c.CustomerId] : c.CustomerId;
                var subject = !string.IsNullOrEmpty(c.Subject)
                    ? c.Subject
                    : (c.Description?.Length > 50 ? c.Description.Substring(0, 50) + "…" : c.Description);
                <tr>
                    <td>@c.CreatedAt.ToSa().ToString("dd MMM yyyy HH:mm")</td>
                    <td>@name</td>
                    <td>@subject</td>
                    <td>@c.Source</td>
                    <td><span class="@pill">@c.Status</span></td>
                    <td><a asp-action="Details" asp-route-id="@c.Id">View</a></td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" style="color:var(--muted);">
                    No complaints yet. Customers submit via mobile, or
                    <a asp-action="Create">record one here</a>.
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
