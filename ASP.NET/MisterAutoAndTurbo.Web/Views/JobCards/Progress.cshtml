@model IEnumerable<JobCard>
@{
    ViewData["Title"] = "Job progress";
}
<div class="page-header">
    <div>
        <h1>Monitor job progress</h1>
        <p>Status updates across the workshop</p>
    </div>
</div>
<div class="card">
    <table class="table">
        <thead><tr><th>Job</th><th>Vehicle</th><th>Status</th><th></th></tr></thead>
        <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var j in Model)
            {
                <tr>
                    <td>@j.Id</td>
                    <td>@j.VehichleId</td>
                    <td>@j.Status</td>
                    <td><a asp-action="Details" asp-route-id="@j.Id">Open</a></td>
                </tr>
            }
        }
        else
        {
            <tr><td colspan="4" style="color:var(--muted);">No progress data yet.</td></tr>
        }
        </tbody>
    </table>
</div>
