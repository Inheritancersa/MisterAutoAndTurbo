@model IEnumerable<Notification>
@{
    ViewData["Title"] = "Notifications";
}
<div class="page-header">
    <div>
        <h1>Notifications</h1>
        <p>Customer quotation alerts and workshop messages</p>
    </div>
</div>

<div class="card">
    <table class="table">
        <thead>
            <tr>
                <th>When</th>
                <th>To</th>
                <th>Type</th>
                <th>Message</th>
                <th>Read</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var n in Model)
            {
                <tr>
                    <td>@n.CreatedAt.ToString("g")</td>
                    <td>@n.UserAccountId</td>
                    <td>@n.Type</td>
                    <td>@n.Message</td>
                    <td>@(n.IsRead ? "Yes" : "No")</td>
                    <td>
                        @if (!string.IsNullOrEmpty(n.RelatedId) && n.Type == "Quotation")
                        {
                            <a asp-controller="Quotations" asp-action="Details" asp-route-id="@n.RelatedId">Quote</a>
                            <span> · </span>
                            <a asp-controller="Quotations" asp-action="CustomerView" asp-route-id="@n.RelatedId">Customer view</a>
                        }
                        @if (!n.IsRead)
                        {
                            <form asp-action="MarkRead" method="post" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@n.Id" />
                                <button type="submit" class="btn btn-ghost" style="padding:4px 8px;font-size:12px;">Mark read</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        }
        else
        {
            <tr><td colspan="6" style="color:var(--muted);">No notifications yet. Send a quotation to a customer to create one.</td></tr>
        }
        </tbody>
    </table>
</div>
