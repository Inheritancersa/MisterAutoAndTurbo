@model Part
@{
    ViewData["Title"] = "Add part";
}
<div class="page-header">
    <div><h1>Add part</h1></div>
    <a class="btn btn-ghost" asp-action="Index">Back</a>
</div>
<div class="card" style="max-width:560px;">
    <div class="card-body" style="padding:24px;">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="field"><label asp-for="StockKeepingUnit">SKU</label><input class="input" asp-for="StockKeepingUnit" /></div>
            <div class="field"><label asp-for="Name">Name</label><input class="input" asp-for="Name" required /></div>
            <div class="field"><label asp-for="Category">Category</label><input class="input" asp-for="Category" /></div>
            <div class="field"><label asp-for="QuantityInStock">Quantity in stock</label><input class="input" asp-for="QuantityInStock" type="number" min="0" /></div>
            <div class="field"><label asp-for="UnitPrice">Unit price (R)</label><input class="input" asp-for="UnitPrice" type="number" step="0.01" min="0" /></div>
            <div class="field"><label asp-for="ReorderLevel">Reorder level</label><input class="input" asp-for="ReorderLevel" type="number" min="0" /></div>
            <button type="submit" class="btn btn-primary" style="margin-top:12px;">Save part</button>
        </form>
    </div>
</div>
