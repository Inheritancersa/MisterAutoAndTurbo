@model Part
@{
    ViewData["Title"] = "Add part";
}
<div class="page-header">
    <div>
        <h1>Add part</h1>
        <p>New item in inventory</p>
    </div>
    <a class="btn btn-ghost" asp-action="Index">Back to inventory</a>
</div>

<div class="card" style="max-width:560px;">
    <div class="card-body" style="padding:24px;">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger" style="margin-bottom:12px;"></div>

            <div class="field">
                <label asp-for="Name">Name</label>
                <input class="input" asp-for="Name" required placeholder="e.g. Turbo boost hose" />
            </div>
            <div class="field">
                <label asp-for="Category">Category</label>
                <input class="input" asp-for="Category" placeholder="e.g. Turbo, Brakes, Service" list="cat-list" />
                <datalist id="cat-list">
                    <option value="Turbo" />
                    <option value="Brakes" />
                    <option value="Service" />
                    <option value="Engine" />
                    <option value="Electrical" />
                    <option value="Body" />
                </datalist>
            </div>
            <div class="field">
                <label asp-for="QuantityInStock">Quantity in stock</label>
                <input class="input" asp-for="QuantityInStock" type="number" min="0" />
            </div>
            <div class="field">
                <label asp-for="UnitPrice">Unit price (R)</label>
                <input class="input" asp-for="UnitPrice" type="number" step="0.01" min="0" />
            </div>
            <div class="field">
                <label asp-for="ReorderLevel">Reorder level</label>
                <input class="input" asp-for="ReorderLevel" type="number" min="0" />
                <small style="color:var(--muted);">Warn when stock falls to this level or below</small>
            </div>

            <button type="submit" class="btn btn-primary" style="margin-top:12px;">Save part</button>
        </form>
    </div>
</div>
