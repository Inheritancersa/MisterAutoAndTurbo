@model Part
@{
    ViewData["Title"] = "Part details";
}
<div class="page-header">
    <div>
        <h1>@Model.Name</h1>
        <p>@Model.StockKeepingUnit · @Model.Category</p>
    </div>
    <a class="btn btn-ghost" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
</div>
<div class="card" style="max-width:480px;">
    <div class="card-body" style="padding:24px;">
        <dl style="display:grid;grid-template-columns:140px 1fr;gap:8px 16px;margin:0;">
            <dt style="color:var(--muted);">Stock</dt><dd>@Model.QuantityInStock</dd>
            <dt style="color:var(--muted);">Unit price</dt><dd>R @Model.UnitPrice.ToString("N2")</dd>
            <dt style="color:var(--muted);">Reorder level</dt><dd>@Model.ReorderLevel</dd>
        </dl>
        <hr style="border:none;border-top:1px solid var(--border);margin:20px 0;" />
        <h3 style="font-size:14px;margin-bottom:12px;">Add to job</h3>
        <form asp-action="AddToJob" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="partId" value="@Model.Id" />
            <div class="field"><label>Job card ID</label><input class="input" name="jobCardId" required /></div>
            <div class="field"><label>Quantity</label><input class="input" type="number" name="quantity" value="1" min="1" /></div>
            <div class="field"><label>Unit price</label><input class="input" type="number" step="0.01" name="unitPrice" value="@Model.UnitPrice" /></div>
            <div class="field">
                <label><input type="checkbox" name="customerSupplied" value="true" /> Customer supplied</label>
            </div>
            <button type="submit" class="btn btn-primary" style="margin-top:8px;">Add to job</button>
        </form>
    </div>
</div>
