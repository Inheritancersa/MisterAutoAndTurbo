@model Part
@{
    ViewData["Title"] = "Edit part";
}
<div class="page-header">
    <div><h1>Edit part</h1></div>
    <a class="btn btn-ghost" asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
</div>
<div class="card" style="max-width:560px;">
    <div class="card-body" style="padding:24px;">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div class="field"><label asp-for="StockKeepingUnit">SKU</label><input class="input" asp-for="StockKeepingUnit" /></div>
            <div class="field"><label asp-for="Name">Name</label><input class="input" asp-for="Name" required /></div>
            <div class="field"><label asp-for="Category">Category</label><input class="input" asp-for="Category" /></div>
            <div class="field"><label asp-for="QuantityInStock">Quantity</label><input class="input" asp-for="QuantityInStock" type="number" /></div>
            <div class="field"><label asp-for="UnitPrice">Unit price</label><input class="input" asp-for="UnitPrice" type="number" step="0.01" /></div>
            <div class="field"><label asp-for="ReorderLevel">Reorder level</label><input class="input" asp-for="ReorderLevel" type="number" /></div>
            <button type="submit" class="btn btn-primary" style="margin-top:12px;">Save</button>
        </form>
    </div>
</div>
