@model Part
@{
    ViewData["Title"] = "Edit part";
}
<div class="page-header">
    <div>
        <h1>Edit part</h1>
        <p>@Model.Name</p>
    </div>
    <a class="btn btn-ghost" asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
</div>

<div class="card" style="max-width:560px;">
    <div class="card-body" style="padding:24px;">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="All" class="text-danger" style="margin-bottom:12px;"></div>

            <div class="field">
                <label asp-for="Name">Name</label>
                <input class="input" asp-for="Name" required />
            </div>
            <div class="field">
                <label asp-for="Category">Category</label>
                <input class="input" asp-for="Category" />
            </div>
            <div class="field">
                <label asp-for="QuantityInStock">Quantity in stock</label>
                <input class="input" asp-for="QuantityInStock" type="number" min="0" />
            </div>
            <div class="field">
                <label asp-for="UnitPrice">Unit price (R)</label>
                <input class="input" asp-for="UnitPrice" type="number" step="0.01" min="0" />
            </div>
            <div class="field">
                <label asp-for="ReorderLevel">Reorder level</label>
                <input class="input" asp-for="ReorderLevel" type="number" min="0" />
            </div>

            <button type="submit" class="btn btn-primary" style="margin-top:12px;">Save changes</button>
        </form>
    </div>
</div>
