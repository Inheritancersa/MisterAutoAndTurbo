@model Payment
@{
    ViewData["Title"] = "Record payment";
}
<div class="page-header">
    <div>
        <h1>Record payment</h1>
        <p>Link payment to a quotation</p>
    </div>
    <a class="btn btn-ghost" asp-action="Index">Back</a>
</div>
<div class="card" style="max-width:560px;">
    <div class="card-body" style="padding:24px;">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="field">
                <label asp-for="QuotationId">Quotation ID</label>
                <input class="input" asp-for="QuotationId" required />
            </div>
            <div class="field">
                <label asp-for="Amount">Amount (R)</label>
                <input class="input" asp-for="Amount" type="number" step="0.01" min="0.01" required />
            </div>
            <div class="field">
                <label asp-for="Method">Method</label>
                <select class="input" asp-for="Method">
                    <option>Cash</option>
                    <option>EFT</option>
                    <option>Card</option>
                    <option>Other</option>
                </select>
            </div>
            <div class="field">
                <label asp-for="ProofOfPaymentUrl">Proof of payment URL (optional)</label>
                <input class="input" asp-for="ProofOfPaymentUrl" placeholder="https://..." />
            </div>
            <div class="field">
                <label asp-for="RecordedById">Recorded by (staff ID)</label>
                <input class="input" asp-for="RecordedById" />
            </div>
            <button type="submit" class="btn btn-primary" style="margin-top:12px;">Save payment</button>
        </form>
    </div>
</div>
