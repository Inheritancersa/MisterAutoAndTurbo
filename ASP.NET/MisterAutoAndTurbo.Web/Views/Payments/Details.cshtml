@model Payment
@{
    ViewData["Title"] = "Payment details";
}
<div class="page-header">
    <div>
        <h1>Payment</h1>
        <p>R @Model.Amount.ToString("N2") · @Model.Status</p>
    </div>
</div>
<div class="card" style="max-width:480px;">
    <div class="card-body" style="padding:24px;">
        <dl style="display:grid;grid-template-columns:160px 1fr;gap:8px 16px;margin:0;">
            <dt style="color:var(--muted);">Quotation</dt><dd>@Model.QuotationId</dd>
            <dt style="color:var(--muted);">Amount</dt><dd>R @Model.Amount.ToString("N2")</dd>
            <dt style="color:var(--muted);">Method</dt><dd>@Model.Method</dd>
            <dt style="color:var(--muted);">Proof</dt><dd>@Model.ProofOfPaymentUrl</dd>
            <dt style="color:var(--muted);">Paid at</dt><dd>@Model.PaidAt.ToString("g")</dd>
            <dt style="color:var(--muted);">Recorded by</dt><dd>@Model.RecordedById</dd>
        </dl>
    </div>
</div>
