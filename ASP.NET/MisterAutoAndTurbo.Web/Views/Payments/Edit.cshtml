@model Payment
@{
    ViewData["Title"] = "Edit payment";
}
<div class="page-header">
    <div>
        <h1>Edit payment</h1>
        <p>@Model.Id</p>
    </div>
    <a class="btn btn-ghost" asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
</div>

<div class="card" style="max-width:560px;">
    <div class="card-body" style="padding:24px;">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="All" class="text-danger" style="margin-bottom:12px;"></div>

            <div class="field">
                <label asp-for="QuotationId">Quotation</label>
                <select class="input" asp-for="QuotationId" asp-items="ViewBag.Quotations" required></select>
            </div>
            <div class="field">
                <label asp-for="Amount">Amount (R)</label>
                <input class="input" asp-for="Amount" type="number" step="0.01" min="0.01" required />
            </div>
            <div class="field">
                <label asp-for="Method">Method</label>
                <select class="input" asp-for="Method">
                    <option value="Cash">Cash</option>
                    <option value="Card">Card</option>
                    <option value="EFT">EFT</option>
                    <option value="Other">Other</option>
                </select>
            </div>
            <div class="field">
                <label asp-for="PaidAt">Paid at</label>
                <input class="input" name="PaidAt" type="datetime-local"
                       value="@Model.PaidAt.ToSa().ToString("yyyy-MM-ddTHH:mm")" />
            </div>
            <div class="field">
                <label asp-for="Status">Status</label>
                <select class="input" asp-for="Status">
                    <option value="Recorded">Recorded</option>
                    <option value="Confirmed">Confirmed</option>
                    <option value="Refunded">Refunded</option>
                </select>
            </div>
            <div class="field">
                <label for="proofFile">Proof of payment</label>
                @if (!string.IsNullOrEmpty(Model.ProofOfPaymentUrl) && (Model.ProofOfPaymentUrl.StartsWith("/uploads/") || Model.ProofOfPaymentUrl.StartsWith("http", StringComparison.OrdinalIgnoreCase)))
                {
                    <p style="margin:0 0 8px;"><a href="@Model.ProofOfPaymentUrl" target="_blank" rel="noopener noreferrer">View current proof</a></p>
                }
                <input class="input" type="file" id="proofFile" name="proofFile"
                       accept=".pdf,.jpg,.jpeg,.png,.webp,image/*,application/pdf" />
                <small style="color:var(--muted);">Choose a file to upload or replace the current proof (PDF/JPG/PNG/WEBP, max 5 MB).</small>
                <input class="input" asp-for="ProofOfPaymentUrl" placeholder="Or a reference number" style="margin-top:8px;" />
            </div>
            <div class="field">
                <label asp-for="RecordedById">Recorded by</label>
                <input class="input" asp-for="RecordedById" />
            </div>

            <button type="submit" class="btn btn-primary" style="margin-top:12px;">Save changes</button>
        </form>
    </div>
</div>
