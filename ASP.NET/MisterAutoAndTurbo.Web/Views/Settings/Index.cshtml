@using MisterAutoAndTurbo.Web.Models
@model MisterAutoAndTurbo.Web.ViewModels.SettingsViewModel
@{
    ViewData["Title"] = "Settings";
}

<div class="page-header">
    <div>
        <h1>Settings</h1>
        <p>Configure your business and system preferences.</p>
    </div>
</div>

<form asp-action="Index" method="post" novalidate>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(340px,1fr));gap:16px;align-items:start;">

        <div class="card">
            <div class="card-head">Business Information</div>
            <div class="card-body" style="padding:20px;">
                <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:0 16px;">
                    <div class="field">
                        <label asp-for="BusinessName">Business Name</label>
                        <input class="input" asp-for="BusinessName" />
                        <span asp-validation-for="BusinessName" class="field-error"></span>
                    </div>
                    <div class="field">
                        <label asp-for="VatNumber">VAT Number</label>
                        <input class="input" asp-for="VatNumber" inputmode="numeric" placeholder="10 digits (optional)" />
                        <span asp-validation-for="VatNumber" class="field-error"></span>
                    </div>
                </div>
                <div class="field">
                    <label asp-for="Address">Address</label>
                    <input class="input" asp-for="Address" placeholder="Street, suburb, city" />
                    <span asp-validation-for="Address" class="field-error"></span>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-head">Payment Settings</div>
            <div class="card-body" style="padding:20px;">
                <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:0 16px;">
                    <div class="field">
                        <label asp-for="Currency">Currency</label>
                        <select class="input" asp-for="Currency">
                            @foreach (var c in BusinessSettings.Currencies)
                            {
                                <option value="@c.Key">@c.Value</option>
                            }
                        </select>
                        <span asp-validation-for="Currency" class="field-error"></span>
                    </div>
                    <div class="field">
                        <label asp-for="VatRate">VAT Rate (%)</label>
                        <input class="input" asp-for="VatRate" type="number" step="0.01" min="0" max="100" />
                        <span asp-validation-for="VatRate" class="field-error"></span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div style="margin-top:16px;">
        <button type="submit" class="btn btn-primary">Save settings</button>
    </div>
</form>
