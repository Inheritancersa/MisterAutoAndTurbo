@using System.Security.Claims
@{
    var role = User.FindFirst(ClaimTypes.Role)?.Value ?? "Manager";
    var displayName = User.Identity?.IsAuthenticated == true ? User.Identity!.Name! : "Motlokoa Tsotesi";
    var initials = string.Concat(displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpper(p[0])));
    var current = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    var main = new List<(string Label, string Controller, string Icon, string[] Roles)>
    {
        ("Dashboard",         "Dashboard",           "bi-grid",           new[] { "Manager", "Receptionist", "Mechanic" }),
        ("Vehicles",          "Vehicles",            "bi-car-front",      new[] { "Manager", "Receptionist", "Mechanic" }),
        ("Customers",         "Customers",           "bi-person",         new[] { "Manager", "Receptionist" }),
        ("Repairs / Jobs",    "JobCards",            "bi-wrench",         new[] { "Manager", "Receptionist", "Mechanic" }),
        ("Quotations",        "Quotations",          "bi-receipt",        new[] { "Manager", "Receptionist" }),
        ("Appointments",      "Appointments",        "bi-calendar3",      new[] { "Manager", "Receptionist", "Mechanic" }),
        ("Parts / Inventory", "Parts",               "bi-box-seam",       new[] { "Manager", "Mechanic" }),
        ("Pricing",           "Pricing",             "bi-tags",           new[] { "Manager" }),
        ("Payments",          "Payments",            "bi-credit-card",    new[] { "Manager", "Receptionist" }),
        ("Collection",        "VehicleCollections",  "bi-key",            new[] { "Manager", "Receptionist" }),
        ("Complaints",        "Complaints",          "bi-chat-left-text", new[] { "Manager", "Receptionist" }),
        ("Reports",           "Dashboard",           "bi-bar-chart",      new[] { "Manager" }),
    };
    var admin = new List<(string Label, string Controller, string Action, string Icon, string[] Roles)>
    {
        ("Performance", "Dashboard", "Performance", "bi-speedometer2", new[] { "Manager" }),
        ("Notifications", "Notifications", "Index", "bi-bell", new[] { "Manager", "Receptionist", "Mechanic" }),
    };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Mister Auto &amp; Turbo</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app">
        <aside class="sidebar">
            <div class="brand">
                <div>Mister<br />Auto &amp; Turbo<small>Your car, my passion</small></div>
            </div>

            <nav>
                @foreach (var item in main.Where(i => i.Roles.Contains(role)))
                {
                    var isReports = item.Label == "Reports";
                    var action = isReports ? "Reports" : "Index";
                    <a class="nav-item @(string.Equals(current, item.Controller, StringComparison.OrdinalIgnoreCase) && !isReports ? "active" : "")"
                       asp-controller="@item.Controller" asp-action="@action">
                        <i class="bi @item.Icon"></i>@item.Label
                    </a>
                }

                @if (admin.Any(i => i.Roles.Contains(role)))
                {
                    <div class="nav-label">Administration</div>
                    @foreach (var item in admin.Where(i => i.Roles.Contains(role)))
                    {
                        <a class="nav-item"
                           asp-controller="@item.Controller" asp-action="@item.Action">
                            <i class="bi @item.Icon"></i>@item.Label
                        </a>
                    }
                }
            </nav>

            <div class="sidebar-footer">
                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="nav-item" style="width:100%;background:none;border:none;text-align:left;cursor:pointer;color:inherit;font:inherit;padding:0;">
                        <i class="bi bi-box-arrow-left"></i>Logout
                    </button>
                </form>
            </div>
        </aside>

        <div class="main">
            <header class="topbar">
                <div class="topbar-title">@ViewData["Title"]</div>
                <div class="topbar-right">
                    <div class="search">
                        <i class="bi bi-search"></i>
                        <input type="search" placeholder="Search vehicles, customers, jobs..." />
                    </div>
                    <a class="icon-btn" title="Notifications" asp-controller="Notifications" asp-action="Index"><i class="bi bi-bell"></i></a>
                    <div class="user-chip">
                        <div class="avatar">@initials</div>
                        <div>
                            <div class="name">@displayName</div>
                            <div class="role">@role</div>
                        </div>
                    </div>
                </div>
            </header>

            <main class="content">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success" style="margin-bottom:16px;padding:12px 16px;background:#e8f8ef;border:1px solid #b7e4c7;border-radius:8px;color:#1b4332;">
                        @TempData["Success"]
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger" style="margin-bottom:16px;padding:12px 16px;background:#fde8e8;border:1px solid #f5c2c2;border-radius:8px;color:#7f1d1d;">
                        @TempData["Error"]
                    </div>
                }
                @RenderBody()
            </main>
        </div>
    </div>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
