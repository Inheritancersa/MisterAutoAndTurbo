@model MisterAutoAndTurbo.Web.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset password";
}

<div class="page-header">
    <div>
        <h1>Reset password</h1>
        <p>Set a new password for <strong>@Model.Username</strong>. Tell them the new password in person or by phone.</p>
    </div>
    <a class="btn btn-ghost" asp-action="Index">Back to users</a>
</div>

<div class="card" style="max-width:600px;">
    <div class="card-body" style="padding:24px;">
        <form asp-action="ResetPassword" asp-route-id="@Model.Id" method="post" novalidate>
            <input type="hidden" asp-for="Id" />

            <div class="field">
                <label asp-for="NewPassword">New password</label>
                <input class="input" asp-for="NewPassword" type="password" autocomplete="new-password" />
                <span asp-validation-for="NewPassword" class="field-error"></span>
                <small style="color:var(--muted);">At least 8 characters, with a letter and a number.</small>
            </div>
            <div class="field">
                <label asp-for="ConfirmPassword">Confirm new password</label>
                <input class="input" asp-for="ConfirmPassword" type="password" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="field-error"></span>
            </div>

            <div style="display:flex;gap:10px;margin-top:18px;">
                <a class="btn btn-ghost" asp-action="Index">Cancel</a>
                <button type="submit" class="btn btn-primary">Reset password</button>
            </div>
        </form>
    </div>
</div>
