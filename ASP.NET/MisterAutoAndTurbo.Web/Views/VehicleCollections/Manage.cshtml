@model VehicleCollection
@{
    ViewData["Title"] = "Manage collection";
    var job = ViewBag.Job as JobCard;
    var customerName = ViewBag.CustomerName as string ?? Model.CustomerId;
    var vehicleLabel = ViewBag.VehicleLabel as string ?? Model.VehicleId;
    var payments = ViewBag.Payments as List<Payment> ?? new List<Payment>();
}
<div class="page-header">
    <div>
        <h1>Manage collection</h1>
        <p>@vehicleLabel · @customerName · Job @Model.JobCardId</p>
    </div>
    <div style="display:flex;gap:8px;">
        <a class="btn btn-ghost" asp-action="Index">All collections</a>
        @if (!string.IsNullOrEmpty(Model.Id))
        {
            <a class="btn btn-ghost" asp-action="Details" asp-route-id="@Model.Id">Details</a>
        }
        <a class="btn btn-ghost" asp-controller="JobCards" asp-action="Details" asp-route-id="@Model.JobCardId">Job card</a>
    </div>
</div>

@if (job != null)
{
    <div style="margin-bottom:16px;padding:12px 16px;border-radius:8px;background:#f3f5f9;">
        Job status: <strong>@job.Status</strong>
        @if (job.Status == "Ready for Collection")
        {
            <span class="pill pill-green" style="margin-left:8px;">Can mark Collected</span>
        }
        else if (job.Status != "Collected")
        {
            <span style="color:var(--muted);margin-left:8px;">Set job to Ready for Collection before completing handover.</span>
        }
    </div>
}

<div class="grid" style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
    <div class="card">
        <div class="card-head">Update collection</div>
        <div class="card-body" style="padding:20px;">
            <form asp-action="UpdateStatus" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="jobCardId" value="@Model.JobCardId" />
                <div class="field">
                    <label>Collection status</label>
                    <select class="input" name="collectionStatus">
                        <option value="Pending">Pending</option>
                        <option value="Ready" selected="@(Model.CollectionStatus == "Ready")">Ready</option>
                        <option value="Collected" selected="@(Model.CollectionStatus == "Collected")">Collected</option>
                        <option value="Cancelled">Cancelled</option>
                    </select>
                </div>
                <div class="field">
                    <label>Collected at</label>
                    <input class="input" type="datetime-local" name="collectedAt"
                           value="@(Model.CollectedAt?.ToString("yyyy-MM-ddTHH:mm") ?? SaTime.Now.ToString("yyyy-MM-ddTHH:mm"))" />
                </div>
                <div class="field">
                    <label>Managed by</label>
                    <input class="input" name="managedById" value="@Model.ManagedById" />
                </div>
                <div class="field">
                    <label>Notes</label>
                    <textarea class="input" name="notes" rows="2">@Model.Notes</textarea>
                </div>
                <button type="submit" class="btn btn-primary" style="margin-top:8px;">Update collection</button>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-head">Payments on file</div>
        <div class="card-body" style="padding:16px;">
            @if (payments.Any())
            {
                <ul style="margin:0;padding-left:18px;">
                    @foreach (var p in payments.Take(5))
                    {
                        <li>R @p.Amount.ToString("N2") · @p.Method · @p.Status · @p.PaidAt.ToSa().ToString("dd MMM")</li>
                    }
                </ul>
            }
            else
            {
                <p style="color:var(--muted);margin:0;">No payments linked yet.
                    <a asp-controller="Payments" asp-action="Create">Record payment</a>
                </p>
            }
        </div>
    </div>
</div>
